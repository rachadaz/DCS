[email]
# Serveur IMAP
imap_server = outlook.office365.com
imap_port = 993
use_ssl = true

# Adresse email de la boite mail qui recoit les scans
username = scanner@votre-domaine.com

# --- Methode d'authentification ---
# "oauth2" pour Microsoft 365 (recommande)
# "basic" pour login/mot de passe classique (si supporte par votre serveur)
auth_method = oauth2

# --- Si auth_method = basic ---
# password = VotreMotDePasse

# --- Si auth_method = oauth2 (Microsoft 365) ---
# Ces 3 valeurs proviennent de l'inscription de l'application dans Azure AD (Entra ID)
# Voir README.md section "Configuration Azure AD" pour les obtenir
tenant_id = xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
client_id = xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
client_secret = votre-client-secret

# Adresse email de l'expediteur HP (scanner/imprimante)
# Supporte plusieurs adresses separees par des virgules
hp_sender = hp-scanner@votre-domaine.com, noreply@hp.com

# Dossier IMAP a surveiller (generalement INBOX)
mailbox = INBOX

[storage]
# Chemin du share reseau
# Exemples:
#   Chemin UNC   : \\SERVEUR\partage\scans
#   Lecteur mappe : S:\scans
share_path = \\SERVEUR\partage\scans

# Organiser les fichiers par date (true/false)
organize_by_date = true

# Prefixe optionnel pour les fichiers (laisser vide si non souhaite)
file_prefix =

[processing]
# Marquer les mails traites comme lus (true/false)
mark_as_read = true

# Deplacer les mails traites dans un dossier (laisser vide pour ne pas deplacer)
move_to_folder = Processed

# Supprimer les mails apres traitement (true/false) - ATTENTION
delete_after_processing = false

# Extensions de pieces jointes a sauvegarder (separees par des virgules, vide = toutes)
allowed_extensions = .pdf, .jpg, .jpeg, .png, .tiff, .tif

[logging]
# Niveau de log: DEBUG, INFO, WARNING, ERROR
log_level = INFO

# Fichier de log
log_file = C:\ProgramData\hp-email-attachment\hp_email_attachment.log
